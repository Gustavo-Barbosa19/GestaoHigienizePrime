# ==========================================
# CONFIGURAÇÃO HIGIENIZE PRIME
# ==========================================

# URL da API do Google Apps Script
# Substitua SEU_SCRIPT_ID pelo ID do seu script implantado
GOOGLE_SHEETS_API_URL=https://script.google.com/macros/s/SEU_SCRIPT_ID/exec

# Nomes das planilhas no Google Sheets
GS_USUARIOS=Usuarios
GS_CLIENTES=Clientes
GS_SERVICOS=Servicos
GS_FINANCEIRO=Financeiro
GS_TIPO_SERVICOS=TipoServicos

# Ambiente
ASPNETCORE_ENVIRONMENT=Development
