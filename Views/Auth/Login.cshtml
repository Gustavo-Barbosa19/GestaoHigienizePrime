@model LoginViewModel
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Login";
}
<div class="card shadow-lg border-0">
    <div class="card-body p-5">
        <div class="text-center mb-4">
            <div class="brand-icon mb-3">
                <i class="bi bi-droplet-half text-primary" style="font-size:3rem;"></i>
            </div>
            <h3 class="fw-bold text-primary">Higienize Prime</h3>
            <p class="text-muted small">Sistema de Gestão</p>
        </div>

        <form asp-action="Login" method="post" autocomplete="off">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Usuario" class="form-label small fw-bold">Usuário</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    <input asp-for="Usuario" class="form-control" placeholder="Digite seu usuário" required autofocus>
                </div>
                <span asp-validation-for="Usuario" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Senha" class="form-label small fw-bold">Senha</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <input asp-for="Senha" class="form-control" placeholder="Digite sua senha" required>
                </div>
                <span asp-validation-for="Senha" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">
                <i class="bi bi-box-arrow-in-right"></i> Entrar
            </button>
        </form>

        <div class="text-center mt-3">
            <small class="text-muted">Higienize Prime &copy; @DateTime.Now.Year</small>
        </div>
    </div>
</div>
