@model List<TipoServico>
@{
    ViewData["Title"] = "Tipos de Serviço";
}
<div class="row g-4">
    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-plus-circle me-2"></i>Novo Tipo de Serviço</h6>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post" class="needs-validation" novalidate>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Nome</label>
                        <input name="nome" class="form-control" required placeholder="Ex: Higienização de Sofá">
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Descrição (opcional)</label>
                        <textarea name="descricao" class="form-control" rows="2" placeholder="Descrição do serviço"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-save"></i> Cadastrar</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-list-check me-2"></i>Tipos Cadastrados</h6>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Nome</th>
                            <th>Descrição</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-medium">@item.Nome</td>
                                <td>@item.Descricao</td>
                                <td class="text-end">
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Excluir este tipo de serviço?')">
                                        <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer bg-white">
                <small class="text-muted">Total: @Model.Count tipo(s) de serviço</small>
            </div>
        </div>
    </div>
</div>
