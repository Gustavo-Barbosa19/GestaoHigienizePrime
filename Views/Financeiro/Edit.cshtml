@model FinanceiroViewModel
@{
    ViewData["Title"] = "Editar Transação";
}
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-bottom py-3">
        <h6 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Editar Transação</h6>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post" class="needs-validation" novalidate>
            <input type="hidden" asp-for="Id">
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label asp-for="Tipo" class="form-label small fw-bold"></label>
                    <select asp-for="Tipo" class="form-select" required id="tipoTransacao">
                        <option value="Entrada">Receita (Entrada)</option>
                        <option value="Saida">Despesa (Saída)</option>
                    </select>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Categoria" class="form-label small fw-bold"></label>
                    <input asp-for="Categoria" class="form-control" readonly>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Descricao" class="form-label small fw-bold"></label>
                    <input asp-for="Descricao" class="form-control" required>
                </div>
                <div class="col-6 col-md-3">
                    <label asp-for="Valor" class="form-label small fw-bold"></label>
                    <div class="input-group">
                        <span class="input-group-text">R$</span>
                        <input asp-for="Valor" class="form-control" type="number" step="0.01" min="0.01" required>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <label asp-for="Data" class="form-label small fw-bold"></label>
                    <input asp-for="Data" class="form-control" type="date" required>
                </div>
            </div>
            <hr class="my-4">
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Salvar</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
