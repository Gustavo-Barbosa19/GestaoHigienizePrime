<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Higienize Prime</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="d-flex" id="wrapper">
        <div class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="mb-0 text-white">Higienize Prime</h5>
                        <small class="text-white-50">Sistema de Gestão</small>
                    </div>
                    <button class="btn btn-link text-white d-md-none" onclick="toggleSidebar()">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>
            <div class="sidebar-user">
                <div class="d-flex align-items-center">
                    <div class="avatar bg-white text-primary rounded-circle d-flex align-items-center justify-content-center me-2" style="width:38px;height:38px;font-weight:bold;">
                        @(Context.Session.GetString("UserFullName")?.Substring(0,1).ToUpper() ?? "U")
                    </div>
                    <div class="text-white small">
                        <div class="fw-bold">@Context.Session.GetString("UserFullName")</div>
                        <div class="text-white-50">@Context.Session.GetString("UserName")</div>
                    </div>
                </div>
            </div>
            <ul class="nav flex-column sidebar-nav">
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Clientes" ? "active" : "")" asp-controller="Clientes" asp-action="Index">
                        <i class="bi bi-people"></i> Clientes
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Servicos" ? "active" : "")" asp-controller="Servicos" asp-action="Index">
                        <i class="bi bi-tools"></i> Serviços
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "TipoServicos" ? "active" : "")" asp-controller="TipoServicos" asp-action="Index">
                        <i class="bi bi-list-check"></i> Tipos de Serviço
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Financeiro" ? "active" : "")" asp-controller="Financeiro" asp-action="Index">
                        <i class="bi bi-cash-stack"></i> Financeiro
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Relatorios" ? "active" : "")" asp-controller="Relatorios" asp-action="Index">
                        <i class="bi bi-file-earmark-bar-graph"></i> Relatórios
                    </a>
                </li>
            </ul>
            <div class="sidebar-footer">
                <form asp-controller="Auth" asp-action="Logout" method="post" id="logoutForm">
                    <button type="submit" class="btn btn-outline-light btn-sm w-100">
                        <i class="bi bi-box-arrow-right"></i> Sair
                    </button>
                </form>
            </div>
        </div>

        <div id="page-content-wrapper">
            <nav class="navbar navbar-expand navbar-light bg-white shadow-sm px-3">
                <div class="container-fluid">
                    <button class="btn btn-outline-primary btn-sm" onclick="toggleSidebar()">
                        <i class="bi bi-list"></i>
                    </button>
                    <span class="navbar-brand ms-2 mb-0 h6 d-none d-sm-inline">@ViewData["Title"]</span>
                    <div class="ms-auto d-flex align-items-center">
                        <form class="d-none d-md-flex me-3" id="globalSearch" onsubmit="return false;">
                            <div class="input-group input-group-sm">
                                <input type="text" class="form-control" id="searchInput" placeholder="Buscar...">
                                <button class="btn btn-outline-primary" type="button"><i class="bi bi-search"></i></button>
                            </div>
                        </form>
                        <span class="badge bg-primary rounded-pill">v1.0</span>
                    </div>
                </div>
            </nav>
            <div class="container-fluid p-4">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show">
                        <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show">
                        <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
