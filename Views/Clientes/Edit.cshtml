@model ClienteViewModel
@{
    ViewData["Title"] = "Editar Cliente";
}
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-bottom py-3">
        <h6 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Editar Cliente</h6>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post" class="needs-validation" novalidate>
            <input type="hidden" asp-for="Id">
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Nome" class="form-label small fw-bold"></label>
                    <input asp-for="Nome" class="form-control" required>
                    <span asp-validation-for="Nome" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Telefone" class="form-label small fw-bold"></label>
                    <input asp-for="Telefone" class="form-control phone-mask" required>
                    <span asp-validation-for="Telefone" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="WhatsApp" class="form-label small fw-bold"></label>
                    <input asp-for="WhatsApp" class="form-control phone-mask">
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Email" class="form-label small fw-bold"></label>
                    <input asp-for="Email" class="form-control" type="email">
                </div>
                <div class="col-12 col-md-3">
                    <label asp-for="CEP" class="form-label small fw-bold"></label>
                    <input asp-for="CEP" class="form-control cep-mask">
                </div>
                <div class="col-12 col-md-3">
                    <label asp-for="Numero" class="form-label small fw-bold"></label>
                    <input asp-for="Numero" class="form-control">
                </div>
                <div class="col-12">
                    <label asp-for="Endereco" class="form-label small fw-bold"></label>
                    <input asp-for="Endereco" class="form-control">
                </div>
                <div class="col-12 col-md-4">
                    <label asp-for="Bairro" class="form-label small fw-bold"></label>
                    <input asp-for="Bairro" class="form-control">
                </div>
                <div class="col-12 col-md-4">
                    <label asp-for="Cidade" class="form-label small fw-bold"></label>
                    <input asp-for="Cidade" class="form-control">
                </div>
                <div class="col-12 col-md-4">
                    <label asp-for="Estado" class="form-label small fw-bold"></label>
                    <select asp-for="Estado" class="form-select">
                        <option value="">Selecione...</option>
                        <option value="AC">AC</option><option value="AL">AL</option><option value="AP">AP</option>
                        <option value="AM">AM</option><option value="BA">BA</option><option value="CE">CE</option>
                        <option value="DF">DF</option><option value="ES">ES</option><option value="GO">GO</option>
                        <option value="MA">MA</option><option value="MT">MT</option><option value="MS">MS</option>
                        <option value="MG">MG</option><option value="PA">PA</option><option value="PB">PB</option>
                        <option value="PR">PR</option><option value="PE">PE</option><option value="PI">PI</option>
                        <option value="RJ">RJ</option><option value="RN">RN</option><option value="RS">RS</option>
                        <option value="RO">RO</option><option value="RR">RR</option><option value="SC">SC</option>
                        <option value="SP">SP</option><option value="SE">SE</option><option value="TO">TO</option>
                    </select>
                </div>
                <div class="col-12">
                    <label asp-for="Observacoes" class="form-label small fw-bold"></label>
                    <textarea asp-for="Observacoes" class="form-control" rows="3"></textarea>
                </div>
            </div>
            <hr class="my-4">
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Salvar</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
