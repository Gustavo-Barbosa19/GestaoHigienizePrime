@model ServicoViewModel
@{
    ViewData["Title"] = "Nova Ordem de Serviço";
}
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-bottom py-3">
        <h6 class="mb-0 fw-bold"><i class="bi bi-file-plus me-2"></i>Nova Ordem de Serviço</h6>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post" class="needs-validation" novalidate>
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label asp-for="ClienteId" class="form-label small fw-bold"></label>
                    <select asp-for="ClienteId" class="form-select" required>
                        <option value="">Selecione um cliente...</option>
                        @if (Model.Clientes != null)
                        {
                            @foreach (var c in Model.Clientes)
                            {
                                <option value="@c.Id">@c.Nome</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="ClienteId" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-3">
                    <label asp-for="DataAtendimento" class="form-label small fw-bold"></label>
                    <input asp-for="DataAtendimento" class="form-control" type="date" required>
                    <span asp-validation-for="DataAtendimento" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-3">
                    <label asp-for="Horario" class="form-label small fw-bold"></label>
                    <input asp-for="Horario" class="form-control" type="time">
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="TipoServico" class="form-label small fw-bold"></label>
                    <select asp-for="TipoServico" class="form-select" required>
                        <option value="">Selecione...</option>
                        @if (Model.TiposServico != null)
                        {
                            @foreach (var t in Model.TiposServico)
                            {
                                <option value="@t.Nome">@t.Nome</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="TipoServico" class="text-danger small"></span>
                </div>
                <div class="col-6 col-md-3">
                    <label asp-for="QuantidadeItens" class="form-label small fw-bold"></label>
                    <input asp-for="QuantidadeItens" class="form-control" type="number" min="1">
                    <span asp-validation-for="QuantidadeItens" class="text-danger small"></span>
                </div>
                <div class="col-6 col-md-3">
                    <label asp-for="Valor" class="form-label small fw-bold"></label>
                    <div class="input-group">
                        <span class="input-group-text">R$</span>
                        <input asp-for="Valor" class="form-control" type="number" step="0.01" min="0.01" required>
                    </div>
                    <span asp-validation-for="Valor" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="FormaPagamento" class="form-label small fw-bold"></label>
                    <select asp-for="FormaPagamento" class="form-select">
                        <option value="">Selecione...</option>
                        <option value="Dinheiro">Dinheiro</option>
                        <option value="Pix">Pix</option>
                        <option value="Cartão de Crédito">Cartão de Crédito</option>
                        <option value="Cartão de Débito">Cartão de Débito</option>
                        <option value="Boleto">Boleto</option>
                        <option value="Transferência">Transferência</option>
                    </select>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Status" class="form-label small fw-bold"></label>
                    <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<StatusServico>()"></select>
                </div>
                <div class="col-12">
                    <label asp-for="Observacoes" class="form-label small fw-bold"></label>
                    <textarea asp-for="Observacoes" class="form-control" rows="3"></textarea>
                </div>
            </div>
            <hr class="my-4">
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Criar OS</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
