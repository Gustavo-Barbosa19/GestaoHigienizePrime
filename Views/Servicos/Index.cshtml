@model List<Servico>
@{
    ViewData["Title"] = "Serviços";
}
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-bottom py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h6 class="mb-0 fw-bold"><i class="bi bi-tools me-2"></i>Ordens de Serviço</h6>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Nova OS</a>
    </div>
    <div class="card-body">
        <div class="d-flex flex-wrap gap-2 mb-3">
            <a asp-action="Index" class="btn btn-sm @(string.IsNullOrEmpty(ViewBag.StatusFilter) ? "btn-primary" : "btn-outline-secondary")">Todos</a>
            @foreach (var status in ViewBag.StatusList)
            {
                <a asp-action="Index" asp-route-statusFilter="@status"
                   class="btn btn-sm @(ViewBag.StatusFilter == status.ToString() ? "btn-primary" : "btn-outline-secondary")">@status</a>
            }
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Cliente</th>
                        <th>Data</th>
                        <th>Tipo</th>
                        <th>Valor</th>
                        <th>Status</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">Nenhum serviço encontrado</td></tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.ClienteNome</td>
                            <td>@item.DataAtendimento.ToString("dd/MM/yyyy")</td>
                            <td>@item.TipoServico</td>
                            <td>R$ @item.Valor.ToString("N2")</td>
                            <td>
                                <span class="badge @(item.Status == StatusServico.Finalizado ? "bg-success" :
                                    item.Status == StatusServico.Cancelado ? "bg-danger" :
                                    item.Status == StatusServico.EmAndamento ? "bg-warning text-dark" :
                                    item.Status == StatusServico.Confirmado ? "bg-info" : "bg-secondary")">
                                    @item.Status
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm" title="Detalhes"><i class="bi bi-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm" title="Editar"><i class="bi bi-pencil"></i></a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Excluir esta OS?')">
                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Excluir"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (ViewBag.TotalPages > 1)
        {
            <nav>
                <ul class="pagination pagination-sm justify-content-center">
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" href="?statusFilter=@ViewBag.StatusFilter&page=@i">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
        <small class="text-muted">Total: @ViewBag.TotalItems OS(s)</small>
    </div>
</div>
